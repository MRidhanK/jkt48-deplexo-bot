{
  "manifest_version": 3,
  "name": "JKT48 Ticket Radar",
  "version": "6.4.0",
  "description": "Pemantau status dan kuota tiket JKT48 dengan laporan Discord.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://jkt48.com/*",
    "https://GANTI-SUBDOMAIN-DEPLEXO/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jkt48.com/purchase/exclusive*"
      ],
      "js": [
        "page_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://jkt48.com/purchase/exclusive*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}