{
  "manifest_version": 3,
  "name": "JKT48 Radar Bridge",
  "version": "1.0.1",
  "permissions": ["storage","alarms"],
  "host_permissions": [
    "https://jkt48.com/*",
    "https://jkt-bot-2shoot.de.deplexo.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://jkt48.com/purchase/exclusive*"],
      "js": ["page_hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://jkt48.com/purchase/exclusive*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}